# 复制为 .env 后按需修改
PORT=3000
# 数据目录（数据库、备份、JWT 密钥）
DATA_DIR=./data
# 登录令牌签名密钥；不填则自动生成并保存在 DATA_DIR/.jwt_secret
JWT_SECRET=
# 首次启动时超级管理员 admin 的初始密码；不填则随机生成并写入 DATA_DIR/INITIAL_ADMIN_PASSWORD.txt
ADMIN_INITIAL_PASSWORD=
# 自动回流扫描间隔（分钟）
RECYCLE_SCAN_MINUTES=10
# 时区（统计“本周”、解析“明天/下周三”用）
TZ=Asia/Shanghai

# —— AI 语音识别（可选）——
# 配置后使用 Claude 做字段抽取；不配置则使用本地规则识别
ANTHROPIC_API_KEY=
# 可选：模型，默认 claude-opus-5-5
AI_MODEL=
# 可选：通过代理/网关访问时填写
ANTHROPIC_BASE_URL=
